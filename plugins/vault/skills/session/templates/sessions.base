filters:
  and:
    - file.inFolder("99 - Meta/Claude/Sessions")
    - type == "session"
properties:
  file.name:
    displayName: Session
  note.status:
    displayName: Status
  note.waiting_for:
    displayName: Waiting for
  note.updated:
    displayName: Updated
  note.machine:
    displayName: Machine
  note.dir:
    displayName: Directory
views:
  - type: table
    name: Open
    filters:
      and:
        - status != "done"
    groupBy:
      property: note.status
      direction: ASC
    order:
      - file.name
      - note.waiting_for
      - note.updated
      - note.machine
      - note.dir
    sort:
      - property: note.updated
        direction: DESC
  - type: table
    name: Archive
    filters:
      and:
        - status == "done"
    order:
      - file.name
      - note.updated
      - note.machine
    sort:
      - property: note.updated
        direction: DESC
